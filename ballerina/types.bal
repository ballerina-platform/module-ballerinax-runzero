# Options which can be set to create or modify a scan
public type ScanOptions record {
    # ID of the explorer that performs the scan
    string agent?;
    # Targets to exclude from the scan
    string excludes?;
    # Optional host ping probe list as comma separated strings. The example shows possibilities
    @jsondata:Name {value: "host-ping-probes"}
    string hostPingProbes?;
    # A description of the scan
    @jsondata:Name {value: "scan-description"}
    string scanDescription?;
    # Whether to ping hosts to detect them before scanning
    @jsondata:Name {value: "host-ping"}
    string hostPing?;
    # Targets to include in the scan
    string targets;
    # ID of the scan template to use
    @jsondata:Name {value: "scan-template"}
    string scanTemplate?;
    # Whether to capture screenshots of discovered web services
    string screenshots?;
    # Maximum number of packets per second sent to a single host
    @jsondata:Name {value: "max-host-rate"}
    string maxHostRate?;
    # A string time duration value representing execution frequency, if scheduled to repeat
    @jsondata:Name {value: "scan-frequency"}
    "once"|"hourly"|"daily"|"weekly"|"monthly"|"continuous" scanFrequency?;
    # Number of scan passes to run
    string passes?;
    # Whether to ping subnets to find live hosts
    @jsondata:Name {value: "subnet-ping"}
    string subnetPing?;
    # Maximum number of packets per second sent overall
    string rate?;
    # The string 'auto' will use any available hosted zone. Otherwise, provide the string name (hostedzone1) or UUID ("e77602e0-3fb8-4734-aef9-fbc6fdcb0fa8") of a hosted zone
    @jsondata:Name {value: "hosted-zone-id"}
    string hostedZoneId?;
    # Maximum number of attempts for each probe
    @jsondata:Name {value: "max-attempts"}
    string maxAttempts?;
    # IP type of service value applied to scan packets
    string tos?;
    # Optional probe list, otherwise all probes are used
    string probes?;
    # Unix timestamp value indicating when the template was created
    @jsondata:Name {value: "scan-start"}
    string scanStart?;
    # Tags to apply to assets discovered by the scan
    @jsondata:Name {value: "scan-tags"}
    string scanTags?;
    # TCP ports to scan
    @jsondata:Name {value: "tcp-ports"}
    string tcpPorts?;
    # Subnet size used when pinging subnets
    @jsondata:Name {value: "subnet-ping-net-size"}
    string subnetPingNetSize?;
    # Share of addresses sampled in each subnet when pinging subnets
    @jsondata:Name {value: "subnet-ping-sample-rate"}
    string subnetPingSampleRate?;
    # Maximum number of hosts scanned in a group
    @jsondata:Name {value: "max-group-size"}
    string maxGroupSize?;
    # The string 'auto' will use any available hosted zone. Otherwise, provide the string name (hostedzone1) of the hosted zone
    @jsondata:Name {value: "hosted-zone-name"}
    string hostedZoneName?;
    # Name of the scan task
    @jsondata:Name {value: "scan-name"}
    string scanName?;
    # Optional subnet ping probe list as comma separated strings. The example shows possibilities
    @jsondata:Name {value: "subnet-ping-probes"}
    string subnetPingProbes?;
    # Maximum number of sockets opened at once
    @jsondata:Name {value: "max-sockets"}
    string maxSockets?;
    # DNS nameservers used for lookups
    string nameservers?;
    # ID of the explorer group that performs the scan
    @jsondata:Name {value: "explorer-group-id"}
    string explorerGroupId?;
    # TCP ports to exclude from the scan
    @jsondata:Name {value: "tcp-excludes"}
    string tcpExcludes?;
    # Grace period allowed for the scan to finish
    @jsondata:Name {value: "scan-grace-period"}
    string scanGracePeriod?;
    # ID of the explorer that performs the scan
    string explorer?;
    # Maximum time-to-live value for scan packets
    @jsondata:Name {value: "max-ttl"}
    string maxTtl?;
};

