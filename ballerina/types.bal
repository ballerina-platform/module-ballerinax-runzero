public type Certificate record {
    @jsondata:Name {value: "public_key"}
    string publicKey?;
    # Whether the certificate has been hidden from the default certificates view
    boolean hidden?;
    # Valid purposes the certificate's key can be used for
    @jsondata:Name {value: "key_usage"}
    string[] keyUsage?;
    string signature?;
    # The subject of the certificate
    string subject?;
    @jsondata:Name {value: "created_at"}
    int createdAt?;
    "x509"|"ssh" 'type?;
    # Subject Alternative Name URIs
    @jsondata:Name {value: "san_uris"}
    string[] sanUris?;
    # When the certificate ceases to be valid
    @jsondata:Name {value: "validity_end"}
    int validityEnd?;
    # The authority which issued the certificate
    string issuer?;
    # The SHA1 hash of the certificate
    @jsondata:Name {value: "fp_sha1"}
    string fpSha1?;
    # The key ID of the subject of the certificate
    @jsondata:Name {value: "subject_key_id"}
    string subjectKeyId?;
    # Zero or more OCSP server URLs
    @jsondata:Name {value: "ocsp_server"}
    string[] ocspServer?;
    # When the certificate was last seen in a response from a service, and updated
    @jsondata:Name {value: "updated_at"}
    int updatedAt?;
    @jsondata:Name {value: "public_key_bits"}
    int:Signed32 publicKeyBits?;
    @jsondata:Name {value: "signature_algorithm"}
    string signatureAlgorithm?;
    # Parameters specific to the public key type
    @jsondata:Name {value: "public_key_parameters"}
    record {} publicKeyParameters?;
    string id;
    # Whether the certificate appears to be self-signed based on subject and authority
    @jsondata:Name {value: "self_signed"}
    boolean selfSigned?;
    # Subject Alternative Name hostnames
    @jsondata:Name {value: "san_dns_names"}
    string[] sanDnsNames?;
    # The SHA256 hash of the certificate
    @jsondata:Name {value: "fp_sha256"}
    string fpSha256?;
    # Zero or more URLs where the issuing certificate can be found
    @jsondata:Name {value: "issuing_certificate_url"}
    string[] issuingCertificateUrl?;
    # The badkeys hash
    @jsondata:Name {value: "fp_bkhash"}
    string fpBkhash?;
    # The Common Name field from the certificate (no longer used by web browsers)
    string cn?;
    # Subject Alternative Name IP addresses
    @jsondata:Name {value: "san_ip_addresses"}
    CertificateSanIpAddresses[] sanIpAddresses?;
    # The MD5 hash of the certificate (for SSH)
    @jsondata:Name {value: "fp_md5"}
    string fpMd5?;
    # The version of the certificate
    int:Signed32 version?;
    # Whether the certificate claims to be a Certificate Authority
    @jsondata:Name {value: "is_ca"}
    boolean isCa?;
    # Subject Alternative Name email addresses
    @jsondata:Name {value: "san_email_addresses"}
    string[] sanEmailAddresses?;
    # Zero or more URLs of CRLs
    @jsondata:Name {value: "crl_distribution_points"}
    string[] crlDistributionPoints?;
    # An assembled list of all names in the certificate
    string[] names?;
    # The key ID of the authority which signed the certificate
    @jsondata:Name {value: "authority_key_id"}
    string authorityKeyId?;
    # The serial number of the certificate
    string serial?;
    @jsondata:Name {value: "organization_id"}
    string organizationId;
    # When the certificate becomes valid
    @jsondata:Name {value: "validity_start"}
    int validityStart?;
    @jsondata:Name {value: "public_key_algorithm"}
    string publicKeyAlgorithm?;
    # Additional purposes the certificate's key can be used for
    @jsondata:Name {value: "ext_key_usage"}
    string[] extKeyUsage?;
};

