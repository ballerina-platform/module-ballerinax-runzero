    string description?;
    # Time the task was created, as a Unix timestamp
    @jsondata:Name {value: "created_at"}
    int createdAt?;
    # Type of the task
    string 'type?;
    # Error message if the task failed
    string 'error?;
    # Client ID associated with the task
    @jsondata:Name {value: "client_id"}
    string clientId?;
    # ID of the processor that handles the task results
    @jsondata:Name {value: "cruncher_id"}
    string cruncherId?;
    # Time the task was last updated, as a Unix timestamp
    @jsondata:Name {value: "updated_at"}
    int updatedAt?;
    # Statistics collected while the task runs
    record {} stats?;
    # Whether the task recurs
    boolean recur?;
    # Unique ID of the task
    string id?;
    # Time the task last recurred, as a Unix timestamp
    @jsondata:Name {value: "recur_last"}
    int recurLast?;
    # The ID of the custom integration source, if the last task executed with this template was an import of Asset Data
    @jsondata:Name {value: "custom_integration_id"}
    string customIntegrationId?;
    # ID of the most recent task created by the recurrence
    @jsondata:Name {value: "recur_last_task_id"}
    string recurLastTaskId?;
    # The ID of the Hosted Zone which executes the task. If the
    @jsondata:Name {value: "hosted_zone_id"}
    string hostedZoneId?;
    # Parameters the task was started with
    record {|string...;|} params?;
    # Name of the creator of the task
    @jsondata:Name {value: "created_by"}
    string createdBy?;
    # ID of the user who created the task
    @jsondata:Name {value: "created_by_user_id"}
    string createdByUserId?;
    # Time the task starts, as a Unix timestamp
    @jsondata:Name {value: "start_time"}
    int startTime?;
    # How often the task recurs
    @jsondata:Name {value: "recur_frequency"}
    string recurFrequency?;
    # ID of the parent task
    @jsondata:Name {value: "parent_id"}
    string parentId?;
    # ID of the organization the task belongs to
    @jsondata:Name {value: "organization_id"}
    string organizationId?;
    # Name of the task
    string name?;
    # ID of the site the task belongs to
    @jsondata:Name {value: "site_id"}
    string siteId?;
    # ID of the scan template the task uses
    @jsondata:Name {value: "template_id"}
    string templateId?;
    # The numeric ID of the data source, if the task executed with this template is a runZero scan or third party data connection import
    @jsondata:Name {value: "source_id"}
    int sourceId?;
    # Time of the next recurrence, as a Unix timestamp
    @jsondata:Name {value: "recur_next"}
    int recurNext?;
    # Current status of the task
    string status?;
};

