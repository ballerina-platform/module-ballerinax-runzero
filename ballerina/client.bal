    remote isolated function splunkAssetSyncCreatedJSON(map<string|string[]> headers = {}, *SplunkAssetSyncCreatedJSONQueries queries) returns AssetsWithCheckpoint|error {
        string resourcePath = string `/export/org/assets/sync/created/assets.json`;
        resourcePath = resourcePath + check getPathForQueryParam(queries);
        return self.clientEp->get(resourcePath, headers);
    }

